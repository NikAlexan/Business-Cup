# cp .env.example .env; generate APP_SECRET with: python -c 'import secrets; print(secrets.token_hex(32))'
APP_SECRET=replace-with-a-random-secret-at-least-32-characters
OPENAI_API_KEY=
AUDIO_MODEL=gpt-audio-1.5
TRANSCRIBE_MODEL=whisper-1
NORMALIZE_MODEL=gpt-4o-mini
DATABASE_URL=postgresql+psycopg://voice:voice@localhost:5432/voice
POSTGRES_PASSWORD=voice
WEB_PORT=8080
POSTGRES_PORT=5432
AUDIO_DATA=audio_data
VAD_MODEL_PATH=models/silero_vad.onnx
FFMPEG_PATH=ffmpeg
REASSESSMENT_DAYS=14
MAX_RECORDING_SECONDS=180
MAX_FILE_BYTES=26214400
MAX_UPLOADS_PER_DAY=60
MAX_ASSESSMENTS_PER_DAY=3
BILLING_PROVIDER=none
DEMO_MODE=false
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
JOB_LEASE_SECONDS=600
JOB_MAX_ATTEMPTS=3
JOB_MAX_RETRY_BATCHES=1
MAX_TOTAL_ASSESSMENTS_PER_DAY=20
MAX_TOTAL_UPLOADS_PER_DAY=300
# BILLING_PROVIDER=stripe_test needs all of these (test keys only: sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_TRIAL_DAYS=7
