{
  "name": "resonance-voice",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health/*"]
  },
  "vars": { "API_ORIGIN": "https://resonance-voice-api-6ed981d3b048.herokuapp.com" }
}
